---
interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, href, linkLabel = 'View all' } = Astro.props;
---

<div class="mb-6 flex items-end justify-between gap-4 border-b border-line pb-3.5">
  <div class="relative pl-4">
    <span class="absolute inset-y-0 left-0 w-1 rounded-full bg-brand-600" aria-hidden="true"></span>
    {eyebrow && <p class="text-[10px] font-black uppercase tracking-[0.18em] text-brand-700">{eyebrow}</p>}
    <h2 class="mt-0.5 text-xl font-black tracking-[-0.035em] text-ink sm:text-2xl">{title}</h2>
  </div>
  {href && (
    <a href={href} class="focus-ring shrink-0 text-xs font-black uppercase tracking-[0.08em] text-brand-700 transition hover:text-brand-500">
      {linkLabel} →
    </a>
  )}
</div>
