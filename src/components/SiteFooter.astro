---
import BrandLogo from './BrandLogo.astro';
import { siteConfig } from '../data/site';

const columns = [
  {
    title: 'News',
    links: [
      ['Latest News', '/latest/'],
      ['Jobs', '/jobs/'],
      ['Education', '/education/'],
      ['Government Schemes', '/schemes/'],
    ],
  },
  {
    title: 'Community',
    links: [
      ['Community', '/community/'],
      ['Training', '/training/'],
      ['Job Fairs', '/job-fairs/'],
      ['Technology', '/technology/'],
      ['Topics', '/topics/'],
    ],
  },
  {
    title: 'Information',
    links: [
      ['About', '/about/'],
      ['Contact', '/contact/'],
      ['Advertise', '/advertise/'],
      ['Privacy', '/privacy/'],
      ['Disclaimer', '/disclaimer/'],
      ['RSS Feed', '/rss.xml'],
    ],
  },
];

const socialLinks = Object.entries(siteConfig.social)
  .filter(([, href]) => Boolean(href))
  .map(([label, href]) => ({ label, href }));

const analyticsEndpoint = 'https://script.google.com/macros/s/AKfycbwwQdJF075JQAOeqXe-IeW-_JNqLNenH9vFjhdweYpk2qNJPnfioymM_v6OfNgidY7_/exec';
const newsletterEndpoint = 'https://script.google.com/macros/s/AKfycbw_744xAqRWa2LA0lAbkCwSooBC0R_tBrywk_dYbEQkcHyd-_w6dKtvySL1BpJbt9DcsA/exec';
---

<footer class="mt-16 border-t-4 border-brand-500 bg-brand-700 text-white">
  <div class="container-site py-11 sm:py-14">
    <div class="grid gap-10 border-b border-white/10 pb-10 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <BrandLogo inverse />
        <p class="mt-5 max-w-md text-sm leading-6 text-white/60">
          News, jobs, education, training, schemes and community updates for Deaf India.
        </p>

        {socialLinks.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {socialLinks.map((link) => (
              <a href={link.href} class="focus-ring border border-white/15 px-3 py-2 text-[10px] font-black uppercase tracking-[0.1em] text-white/75 hover:border-white/40 hover:text-white">
                {link.label}
              </a>
            ))}
          </div>
        )}

        <div
          id="ga-footer-stats"
          class="mt-6 hidden max-w-sm rounded-xl border border-white/15 bg-white/5 p-4"
          aria-live="polite"
        >
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-white/45">Website statistics</p>
          <div class="mt-3 grid grid-cols-2 gap-4">
            <div>
              <p id="ga-total-users" class="text-xl font-bold leading-none text-white">—</p>
              <p class="mt-1 text-[11px] text-white/55">Visitors</p>
            </div>
            <div>
              <p id="ga-page-views" class="text-xl font-bold leading-none text-white">—</p>
              <p class="mt-1 text-[11px] text-white/55">Page views</p>
            </div>
          </div>
          <p class="mt-3 text-[10px] leading-4 text-white/35">Source: Google Analytics</p>
        </div>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        {columns.map((column) => (
          <div>
            <h2 class="border-l-[3px] border-purple-200 pl-3 text-[10px] font-black uppercase tracking-[0.18em] text-white/45">{column.title}</h2>
            <ul class="mt-5 space-y-3 text-sm font-semibold">
              {column.links.map(([label, href]) => (
                <li><a class="focus-ring transition hover:text-white" href={href}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <section class="border-b border-white/10 py-8" aria-labelledby="newsletter-title">
      <div class="grid gap-5 lg:grid-cols-[1fr_1.25fr] lg:items-end">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.16em] text-purple-200">Free email updates</p>
          <h2 id="newsletter-title" class="mt-2 text-xl font-bold text-white">Get DeafJobsIndia Job Updates by Email</h2>
          <p class="mt-2 max-w-xl text-sm leading-6 text-white/55">
            Receive verified Deaf, Hard of Hearing and PwD job updates, important deadlines and official application links.
          </p>
        </div>

        <form id="newsletter-form" class="space-y-3" novalidate>
          <div class="flex flex-col gap-2 sm:flex-row">
            <label class="sr-only" for="newsletter-email">Email address</label>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              required
              placeholder="Enter your email address"
              class="focus-ring min-w-0 flex-1 rounded-lg border border-white/20 bg-white px-4 py-3 text-sm text-black placeholder:text-gray-500"
            />
            <button
              id="newsletter-submit"
              type="submit"
              class="focus-ring rounded-lg bg-white px-5 py-3 text-sm font-bold text-brand-700 transition hover:bg-purple-50 disabled:cursor-not-allowed disabled:opacity-60"
            >
              Subscribe
            </button>
          </div>
          <p class="text-[11px] leading-5 text-white/40">
            By subscribing, you agree to receive DeafJobsIndia job-update emails. You can unsubscribe later.
          </p>
          <p id="newsletter-message" class="hidden text-sm font-semibold" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <div class="flex flex-col gap-3 pt-6 text-[11px] text-white/40 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 DeafJobsIndia. All rights reserved.</p>
      <p>Connecting Deaf Talent with Opportunities</p>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ analyticsEndpoint, newsletterEndpoint }}>
  (() => {
    const stats = document.getElementById('ga-footer-stats');
    const users = document.getElementById('ga-total-users');
    const views = document.getElementById('ga-page-views');

    if (stats && users && views) {
      const formatNumber = (value) => new Intl.NumberFormat('en-IN').format(Number(value) || 0);
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 8000);

      fetch(analyticsEndpoint, {
        method: 'GET',
        cache: 'no-store',
        signal: controller.signal,
      })
        .then((response) => {
          if (!response.ok) throw new Error('Analytics endpoint request failed');
          return response.json();
        })
        .then((data) => {
          if (!data || data.success !== true) throw new Error('Analytics endpoint returned an error');
          users.textContent = formatNumber(data.totalUsers);
          views.textContent = formatNumber(data.pageViews);
          stats.classList.remove('hidden');
        })
        .catch(() => {
          // Keep the statistics panel hidden if Google Analytics data is unavailable.
        })
        .finally(() => window.clearTimeout(timer));
    }

    const form = document.getElementById('newsletter-form');
    const emailInput = document.getElementById('newsletter-email');
    const submitButton = document.getElementById('newsletter-submit');
    const message = document.getElementById('newsletter-message');

    if (!form || !emailInput || !submitButton || !message) return;

    const showMessage = (text, ok) => {
      message.textContent = text;
      message.classList.remove('hidden', 'text-green-200', 'text-red-200');
      message.classList.add(ok ? 'text-green-200' : 'text-red-200');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = emailInput.value.trim().toLowerCase();
      const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (!validEmail.test(email)) {
        showMessage('Please enter a valid email address.', false);
        emailInput.focus();
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = 'Subscribing…';
      message.classList.add('hidden');

      const body = new URLSearchParams({
        email,
        source: 'DeafJobsIndia Website Footer',
      });

      try {
        let handled = false;

        try {
          const response = await fetch(newsletterEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body,
            redirect: 'follow',
          });

          if (response.ok) {
            const data = await response.json();
            if (data && data.success === true) {
              showMessage(data.message || 'Subscription successful! Please check your email.', true);
              emailInput.value = '';
              handled = true;
            } else if (data) {
              showMessage(data.message || 'Unable to subscribe right now. Please try again.', false);
              handled = true;
            }
          }
        } catch (_) {
          // Apps Script can block readable cross-origin responses after its redirect.
          // Fall back to an opaque POST so the subscription still reaches Google Apps Script.
        }

        if (!handled) {
          await fetch(newsletterEndpoint, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
            body,
          });
          showMessage('Subscription request sent. Please check your email for confirmation.', true);
          emailInput.value = '';
        }
      } catch (_) {
        showMessage('Unable to subscribe right now. Please try again later.', false);
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Subscribe';
      }
    });
  })();
</script>
