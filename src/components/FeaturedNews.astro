---
import CategoryBadge from './CategoryBadge.astro';

interface Story {
  category: string;
  title: string;
  excerpt?: string;
  href: string;
  image: string;
  imageAlt?: string;
  date?: string;
}

interface Props {
  lead: Story;
  side: Story[];
}

const { lead, side } = Astro.props;
---

<section class="container-site py-6 sm:py-8 lg:py-10" aria-labelledby="featured-heading">
  <div class="mb-4 flex items-center justify-between gap-4">
    <div>
      <p class="text-[10px] font-black uppercase tracking-[0.2em] text-brand-700">DeafJobsIndia Newsroom</p>
      <h1 id="featured-heading" class="mt-1 text-2xl font-black tracking-[-0.04em] text-ink sm:text-3xl">
        Today’s Top Stories
      </h1>
    </div>
    <a href="/latest/" class="focus-ring hidden text-xs font-black uppercase tracking-[0.08em] text-brand-700 hover:text-brand-500 sm:block">
      All news →
    </a>
  </div>

  <div class="grid gap-4 lg:grid-cols-[minmax(0,1.6fr)_minmax(310px,.8fr)]">
    <article class="overflow-hidden rounded-2xl border border-line bg-white shadow-[0_12px_36px_rgba(17,17,17,.06)]">
      <a href={lead.href} class="focus-ring group block">
        <div class="relative aspect-[16/10] overflow-hidden bg-surface sm:aspect-[16/8.6]">
          <img
            src={lead.image}
            alt={lead.imageAlt ?? ''}
            width="1280"
            height="720"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
          />
          <div class="absolute inset-x-0 top-0 h-1.5 bg-brand-600"></div>
        </div>

        <div class="p-5 sm:p-7 lg:p-8">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-brand-700 px-3 py-1 text-[9px] font-black uppercase tracking-[0.14em] text-white">
              Top Story
            </span>
            <CategoryBadge category={lead.category} />
            {lead.date && <time class="text-[10px] font-bold uppercase tracking-[0.08em] text-muted">{lead.date}</time>}
          </div>

          <h2 class="mt-4 max-w-4xl text-2xl font-black leading-[1.08] tracking-[-0.04em] text-ink transition group-hover:text-brand-700 sm:text-3xl lg:text-[2.35rem]">
            {lead.title}
          </h2>

          {lead.excerpt && (
            <p class="mt-4 max-w-3xl text-sm leading-6 text-muted sm:text-base sm:leading-7">
              {lead.excerpt}
            </p>
          )}

          <span class="mt-5 inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.08em] text-brand-700">
            Read full story <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    </article>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
      {side.slice(0, 2).map((story) => (
        <article class="overflow-hidden rounded-2xl border border-line bg-white">
          <a href={story.href} class="focus-ring group grid h-full sm:grid-rows-[auto_1fr]">
            <div class="aspect-[16/9] overflow-hidden bg-surface lg:aspect-[16/8.2]">
              <img
                src={story.image}
                alt={story.imageAlt ?? ''}
                width="720"
                height="405"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]"
              />
            </div>
            <div class="p-5">
              <div class="flex flex-wrap items-center gap-2">
                <CategoryBadge category={story.category} />
                {story.date && <time class="text-[9px] font-bold uppercase tracking-[0.08em] text-muted">{story.date}</time>}
              </div>
              <h3 class="mt-3 text-lg font-black leading-[1.12] tracking-[-0.03em] text-ink transition group-hover:text-brand-700 sm:text-xl">
                {story.title}
              </h3>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
