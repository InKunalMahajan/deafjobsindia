---
import SectionLayout from '../layouts/SectionLayout.astro';

const contactOptions = [
  {
    title: 'Job Seekers',
    description:
      'Need help finding a suitable job, understanding a job listing, or reporting an expired opportunity? Contact DeafJobsIndia.',
    label: 'Job Support',
  },
  {
    title: 'Employers',
    description:
      'Looking to recruit Deaf and Hard of Hearing candidates or publish an inclusive job opportunity? Get in touch with us.',
    label: 'Hiring',
  },
  {
    title: 'Partnerships',
    description:
      'We welcome collaboration with companies, NGOs, Deaf organisations, educational institutions and training centres.',
    label: 'Collaborate',
  },
];
---

<SectionLayout
  title="Contact DeafJobsIndia"
  description="Contact DeafJobsIndia for job support, employer enquiries, corrections, partnerships and general enquiries."
  eyebrow="Contact"
>
  <div class="space-y-10">

    <!-- Intro -->
    <section class="max-w-3xl">
      <p class="text-base leading-7 text-muted sm:text-lg">
        Have a question, suggestion or opportunity to share?
        DeafJobsIndia is here to support Deaf and Hard of Hearing job seekers,
        employers and organisations across India.
      </p>
    </section>


    <!-- Contact Categories -->
    <section class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {contactOptions.map((item) => (
        <article class="border border-line bg-white p-6">
          <span
            class="text-[10px] font-black uppercase tracking-[0.15em] text-brand-700"
          >
            {item.label}
          </span>

          <h2 class="mt-3 text-xl font-black tracking-[-0.025em] text-black">
            {item.title}
          </h2>

          <p class="mt-3 text-sm leading-6 text-muted">
            {item.description}
          </p>
        </article>
      ))}
    </section>


    <!-- Contact Form -->
    <section class="grid gap-8 border-t border-line pt-10 lg:grid-cols-[0.8fr_1.2fr]">

      <!-- Information -->
      <div>
        <span
          class="text-[10px] font-black uppercase tracking-[0.15em] text-brand-700"
        >
          Get in Touch
        </span>

        <h2 class="mt-3 text-2xl font-black tracking-[-0.03em] sm:text-3xl">
          Send us a message
        </h2>

        <p class="mt-4 max-w-lg text-sm leading-7 text-muted">
          Use the contact form for job-related questions, employer enquiries,
          corrections, feedback or partnership requests.
        </p>

        <div class="mt-8 border-l-4 border-brand-700 bg-gray-50 p-5">
          <h3 class="text-sm font-black">
            Accessible Communication
          </h3>

          <p class="mt-2 text-sm leading-6 text-muted">
            DeafJobsIndia encourages accessible communication through email,
            text and online messaging.
          </p>
        </div>
      </div>


      <!-- Form -->
      <form class="border border-line bg-white p-6 sm:p-8">

        <div class="grid gap-5 sm:grid-cols-2">

          <!-- Name -->
          <div>
            <label
              for="name"
              class="mb-2 block text-xs font-black uppercase tracking-wide"
            >
              Full Name
            </label>

            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Your name"
              class="w-full border border-line bg-white px-4 py-3 text-sm outline-none transition focus:border-brand-700"
            />
          </div>


          <!-- Email -->
          <div>
            <label
              for="email"
              class="mb-2 block text-xs font-black uppercase tracking-wide"
            >
              Email Address
            </label>

            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full border border-line bg-white px-4 py-3 text-sm outline-none transition focus:border-brand-700"
            />
          </div>

        </div>


        <!-- Subject -->
        <div class="mt-5">
          <label
            for="subject"
            class="mb-2 block text-xs font-black uppercase tracking-wide"
          >
            Enquiry Type
          </label>

          <select
            id="subject"
            name="subject"
            required
            class="w-full border border-line bg-white px-4 py-3 text-sm outline-none transition focus:border-brand-700"
          >
            <option value="">Select an option</option>
            <option value="job-seeker">Job Seeker Support</option>
            <option value="employer">Employer / Recruitment</option>
            <option value="job-listing">Job Listing / Correction</option>
            <option value="partnership">Partnership</option>
            <option value="feedback">Feedback</option>
            <option value="other">General Enquiry</option>
          </select>
        </div>


        <!-- Message -->
        <div class="mt-5">
          <label
            for="message"
            class="mb-2 block text-xs font-black uppercase tracking-wide"
          >
            Message
          </label>

          <textarea
            id="message"
            name="message"
            rows="6"
            required
            placeholder="How can we help you?"
            class="w-full resize-y border border-line bg-white px-4 py-3 text-sm outline-none transition focus:border-brand-700"
          ></textarea>
        </div>


        <!-- Preferred Communication -->
        <div class="mt-5">
          <label
            for="communication"
            class="mb-2 block text-xs font-black uppercase tracking-wide"
          >
            Preferred Communication
          </label>

          <select
            id="communication"
            name="communication"
            class="w-full border border-line bg-white px-4 py-3 text-sm outline-none transition focus:border-brand-700"
          >
            <option value="email">Email</option>
            <option value="text">Text / Online Message</option>
          </select>
        </div>


        <!-- Submit -->
        <button
          type="submit"
          class="mt-6 inline-flex items-center justify-center bg-brand-700 px-6 py-3 text-sm font-black text-white transition hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-brand-700 focus:ring-offset-2"
        >
          Send Message
        </button>

      </form>
    </section>


    <!-- Additional Information -->
    <section class="border-t border-line pt-10">
      <div class="grid gap-6 md:grid-cols-2">

        <div>
          <span
            class="text-[10px] font-black uppercase tracking-[0.15em] text-brand-700"
          >
            Corrections
          </span>

          <h2 class="mt-3 text-xl font-black">
            Found incorrect information?
          </h2>

          <p class="mt-2 text-sm leading-6 text-muted">
            If a job listing is expired, incorrect or contains misleading
            information, please contact us so we can review and update it.
          </p>
        </div>

        <div>
          <span
            class="text-[10px] font-black uppercase tracking-[0.15em] text-brand-700"
          >
            Community
          </span>

          <h2 class="mt-3 text-xl font-black">
            Help us improve DeafJobsIndia
          </h2>

          <p class="mt-2 text-sm leading-6 text-muted">
            Suggestions from job seekers, employers and the Deaf community help
            us build a more useful and accessible employment platform.
          </p>
        </div>

      </div>
    </section>

  </div>
</SectionLayout>