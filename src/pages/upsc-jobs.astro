---
import SeoJobsLanding from '../components/SeoJobsLanding.astro';
---

<SeoJobsLanding
  title="UPSC Jobs for Deaf & Hard of Hearing Candidates in India"
  description="Latest UPSC recruitment updates for Deaf, Hard of Hearing and PwBD candidates in India, with post suitability, reservation, eligibility, deadlines and official notification links."
  eyebrow="UPSC Jobs"
  intro={[
    'Track Union Public Service Commission recruitment updates that may be relevant to Deaf, Hard of Hearing and PwBD candidates. DeafJobsIndia highlights disability suitability and reservation information when it is stated in the official UPSC advertisement.',
    'UPSC eligibility can differ significantly by post. Candidates should always verify the identified disability category, benchmark disability requirements, age relaxation, qualification and medical standards in the complete official notification.',
  ]}
  highlights={[
    'UPSC recruitment notifications and vacancy updates',
    'Deaf and Hard of Hearing suitability where officially listed',
    'PwBD reservation and age-relaxation information',
    'Educational qualification and experience requirements',
    'Application deadlines and recruitment-test dates',
    'Official UPSC notification and application links',
  ]}
  matchTags={['UPSC']}
  matchTerms={['union public service commission', 'upsc']}
  relatedLinks={[
    { label: 'Government Jobs', href: '/government-jobs/', description: 'Browse government recruitment updates for Deaf, HH and PwD candidates.' },
    { label: 'SSC Jobs', href: '/ssc-jobs/', description: 'Staff Selection Commission recruitment updates and PwBD information.' },
    { label: 'Railway Jobs', href: '/railway-jobs/', description: 'Railway recruitment updates relevant to Deaf and PwD candidates.' },
    { label: 'PwD Jobs', href: '/pwd-jobs/', description: 'Jobs with PwD or PwBD eligibility and reservation information.' },
  ]}
  emptyMessage="No verified UPSC job updates match this page yet. New UPSC recruitment notices relevant to Deaf, HH or PwBD candidates will appear here."
/>
