---
import SeoJobsLanding from '../components/SeoJobsLanding.astro';
---

<SeoJobsLanding
  title="Railway Jobs for Deaf & Hard of Hearing Candidates in India"
  description="Latest Railway and RRB recruitment updates for Deaf, Hard of Hearing and PwBD candidates, with post suitability, reservation, eligibility and official application links."
  eyebrow="Railway Jobs"
  intro={[
    'Track Indian Railways and Railway Recruitment Board job updates that may be relevant to Deaf, Hard of Hearing and PwBD candidates. DeafJobsIndia focuses on post suitability, reservation, qualifications and official recruitment dates.',
    'Railway medical standards and disability suitability vary by post. Candidates should carefully verify the relevant RRB or Railway notification before submitting an application.',
  ]}
  highlights={[
    'RRB and Indian Railways recruitment updates',
    'Deaf and Hard of Hearing suitability where officially listed',
    'PwBD reservation and age-relaxation information',
    'Post-wise qualification and medical requirements',
    'Application, CBT and document-verification dates',
    'Official RRB and Railway recruitment links',
  ]}
  matchTags={['Railway', 'RRB']}
  matchTerms={['railway recruitment board', 'indian railways', 'rrb']}
  relatedLinks={[
    { label: 'Government Jobs', href: '/government-jobs/', description: 'Browse government recruitment updates across India.' },
    { label: 'SSC Jobs', href: '/ssc-jobs/', description: 'SSC recruitment updates for Deaf, HH and PwBD candidates.' },
    { label: 'PwD Jobs', href: '/pwd-jobs/', description: 'Jobs with PwD or PwBD eligibility and reservation information.' },
    { label: 'Maharashtra Jobs', href: '/maharashtra-jobs/', description: 'Employment and recruitment updates connected to Maharashtra.' },
  ]}
  emptyMessage="No verified Railway job updates match this page yet. Relevant RRB and Railway recruitment notices will appear here as they are published."
/>
