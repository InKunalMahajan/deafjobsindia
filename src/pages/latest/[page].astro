---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import SectionLayout from '../../layouts/SectionLayout.astro';
import NewsArchive from '../../components/NewsArchive.astro';
import Pagination from '../../components/Pagination.astro';
import { POSTS_PER_PAGE, paginatePosts, sortPosts, type NewsPost , getPublicPosts} from '../../utils/news';

interface Props {
  posts: NewsPost[];
  currentPage: number;
  totalPages: number;
  totalItems: number;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = getPublicPosts(await getCollection('news'));
  const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    const page = paginatePosts(posts, currentPage);
    return {
      params: { page: String(currentPage) },
      props: {
        posts: page.items,
        currentPage,
        totalPages,
        totalItems: posts.length,
      },
    };
  });
};

const { posts, currentPage, totalPages, totalItems } = Astro.props;
---

<SectionLayout
  title={`Latest News — Page ${currentPage}`}
  description="More DeafJobsIndia stories in chronological order."
  eyebrow="Latest"
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Latest News', href: '/latest/' },
    { label: `Page ${currentPage}` },
  ]}
>
  <div class="mb-7 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm font-semibold text-muted">{totalItems} published stories</p>
    <span class="text-xs font-black uppercase tracking-[0.12em] text-brand-700">Page {currentPage} of {totalPages}</span>
  </div>
  <NewsArchive posts={posts} />
  <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/latest/" />
</SectionLayout>
