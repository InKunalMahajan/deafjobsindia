---
import SeoJobsLanding from '../components/SeoJobsLanding.astro';
---

<SeoJobsLanding
  title="SSC Jobs for Deaf & Hard of Hearing Candidates in India"
  description="Latest SSC recruitment updates for Deaf, Hard of Hearing and PwBD candidates, including disability suitability, reservation, eligibility, exam dates and official links."
  eyebrow="SSC Jobs"
  intro={[
    'Find Staff Selection Commission recruitment updates that may be suitable for Deaf, Hard of Hearing and PwBD candidates. DeafJobsIndia will summarise the most important disability-related eligibility details from official SSC notices.',
    'Suitability for Deaf and Hard of Hearing candidates depends on the specific post and functional requirements. Always check the official SSC notification and post-wise PwBD suitability before applying.',
  ]}
  highlights={[
    'SSC recruitment notifications and vacancy news',
    'Post-wise PwBD suitability information',
    'Deaf and Hard of Hearing eligibility where listed',
    'Reservation and age-relaxation details',
    'Important application and examination dates',
    'Official SSC notification and application sources',
  ]}
  matchTags={['SSC']}
  matchTerms={['staff selection commission', 'ssc']}
  relatedLinks={[
    { label: 'Government Jobs', href: '/government-jobs/', description: 'Government recruitment updates relevant to Deaf, HH and PwD candidates.' },
    { label: 'UPSC Jobs', href: '/upsc-jobs/', description: 'UPSC recruitment updates with disability eligibility information.' },
    { label: 'Railway Jobs', href: '/railway-jobs/', description: 'Railway recruitment updates for Deaf and PwD job seekers.' },
    { label: 'Deaf Jobs', href: '/deaf-jobs/', description: 'Jobs specifically relevant to Deaf and Hard of Hearing candidates.' },
  ]}
  emptyMessage="No verified SSC job updates match this page yet. New SSC recruitment notices relevant to Deaf, HH or PwBD candidates will appear here."
/>
