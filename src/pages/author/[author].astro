---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import SectionLayout from '../../layouts/SectionLayout.astro';
import NewsArchive from '../../components/NewsArchive.astro';
import { getAllAuthors, getPostAuthor, getPublicPosts, slugify, type NewsPost } from '../../utils/news';

interface Props {
  authorName: string;
  authorRole: string;
  authorBio: string;
  authorAvatar: string;
  posts: NewsPost[];
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = getPublicPosts(await getCollection('news'));
  const authors = getAllAuthors(posts);

  return authors.map(({ slug, name }) => {
    const authorPosts = posts.filter((post) => slugify(getPostAuthor(post).name) === slug);
    const profile = authorPosts[0] ? getPostAuthor(authorPosts[0]) : null;

    return {
      params: { author: slug },
      props: {
        authorName: profile?.name ?? name,
        authorRole: profile?.role ?? 'Contributor',
        authorBio: profile?.bio ?? `Articles and updates published by ${name}.`,
        authorAvatar: profile?.avatar ?? '/images/author-desk.svg',
        posts: authorPosts,
      },
    };
  });
};

const { authorName, authorRole, authorBio, authorAvatar, posts } = Astro.props;
---

<SectionLayout
  title={authorName}
  description={`Articles and updates published by ${authorName}.`}
  eyebrow="Author"
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: authorName },
  ]}
>
  <div class="mb-8 flex items-start gap-4 border border-line bg-surface p-5 sm:p-6">
    <img
      src={authorAvatar}
      alt=""
      width="64"
      height="64"
      loading="lazy"
      decoding="async"
      class="h-16 w-16 shrink-0 rounded-full object-cover"
    />
    <div>
      <p class="text-[10px] font-black uppercase tracking-[0.16em] text-brand-700">{authorRole}</p>
      <p class="mt-1 text-xl font-black text-ink">{authorName}</p>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">{authorBio}</p>
      <p class="mt-3 text-xs font-bold text-muted">{posts.length} published {posts.length === 1 ? 'story' : 'stories'}</p>
    </div>
  </div>

  <NewsArchive posts={posts} />
</SectionLayout>
